# Copy values into a private shell or env file. Never commit real credentials.
PM2S_CLEAN_ROOT=/path/to/pm2s-clean
PROCMEM2SKILLS_ROOT=/path/to/procmem2skills
TASK_SOURCE_ROOT=/path/to/procmem2skills/benchmarks/harbor-datasets
SKILLSBENCH_ROOT=/path/to/skillsbench
PM2S_RESULTS_ROOT=/path/to/results
PM2S_RETRIEVAL_ROOT=/path/to/skill-retrieval-data

PROVIDER=google
API_KEY_ENV=GOOGLE_API_KEY
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT=gemini-cli
MODEL=google/gemini-3.1-pro-preview

N_ATTEMPTS=5
N_CONCURRENT=10
MAX_STEPS=20
COMMAND_TIMEOUT_SEC=1200
